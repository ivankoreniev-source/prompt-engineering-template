{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/scripts/pre_tool_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "architecture-reminder": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python .agents/scripts/pre_invocation_reminder.py",
        "timeout": 10
      }
    ]
  },
  "post-command-audit": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/scripts/post_tool_audit.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
